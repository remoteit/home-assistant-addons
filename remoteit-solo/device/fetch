#!/bin/sh
# Fetch the remote.it device for this machine from solo's downloads and lay it out as the device image does
# (/usr/lib/remoteit-device: connectd, stages/, BUILD, default-stage, entrypoint, healthcheck) with the add-on's panel
# beside them (remoteit-panel) — run by the Dockerfile while Supervisor builds the add-on on the Home Assistant machine.
# Two packages of one build, both named by its manifest: the device's tarball (tar-<arch>) and the container pieces
# (container-<arch>: remoteit-device's container/ entrypoint and healthcheck, and container/panel built).
#
#   fetch <version> <Home Assistant arch> <destination>
#
# Checked as the device's installer (remoteit-device install.sh) checks a first install on Linux: the version's
# manifest must be signed (Ed25519) by a key in release-keys beside this script — solo's release key, the one
# remoteit-device holds for the stage — and each package must match the SHA-256 the manifest gives for it.
# Anything else fails the build.
set -eu
version=${1:?usage: fetch <version> <arch> <destination>}
arch=${2:?usage: fetch <version> <arch> <destination>}
dest=${3:?usage: fetch <version> <arch> <destination>}
base=${R3_DOWNLOADS:-https://downloads.solo.remote.it/device}/$version
keys=$(dirname "$0")/release-keys
fail() { echo "fetch: $*" >&2; exit 1; }

# Home Assistant's architectures, as the package's tarballs name them.
case $arch in
  aarch64) tar_arch=arm64 ;;
  amd64) tar_arch=amd64 ;;
  *) fail "no package for $arch" ;;
esac
[ -s "$keys" ] || fail "no release key to check the manifest with"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
curl -fsSL --retry 3 -o "$tmp/manifest.json" "$base/manifest.json" || fail "cannot fetch $base/manifest.json"
curl -fsSL --retry 3 -o "$tmp/manifest.json.sig" "$base/manifest.json.sig" || fail "the manifest is not signed"

# The signature: base64 of the raw Ed25519 signature over the manifest's bytes; each key base64 of its DER.
openssl base64 -d -A -in "$tmp/manifest.json.sig" -out "$tmp/manifest.sig.bin" || fail "the signature is not base64"
verified=
for k in $(cat "$keys"); do
  printf '%s\n' '-----BEGIN PUBLIC KEY-----' "$k" '-----END PUBLIC KEY-----' > "$tmp/release.pem"
  if openssl pkeyutl -verify -pubin -inkey "$tmp/release.pem" -rawin -in "$tmp/manifest.json" \
    -sigfile "$tmp/manifest.sig.bin" >/dev/null 2>&1; then
    verified=1
    break
  fi
done
[ -n "$verified" ] || fail "the manifest of $version is not signed by solo's release key"

got=$(jq -r .version "$tmp/manifest.json")
[ "$got" = "$version" ] || fail "the manifest is $got, not $version"

# get <manifest key>: that package, downloaded and checked against the manifest's SHA-256, unpacked; prints its directory.
get() {
  pkg=$(jq -r --arg k "$1" '.[$k] // empty' "$tmp/manifest.json")
  sha=$(jq -r --arg k "$1_sha256" '.[$k] // empty' "$tmp/manifest.json")
  [ -n "$pkg" ] && [ -n "$sha" ] || fail "the manifest of $version has no $1 package"
  case $pkg in */*|..*) fail "the manifest names '$pkg'" ;; esac
  echo "fetch: $pkg (manifest signed by solo's release key)" >&2
  curl -fsSL --retry 3 -o "$tmp/$pkg" "$base/$pkg" || fail "cannot fetch $base/$pkg"
  [ "$(sha256sum "$tmp/$pkg" | cut -d' ' -f1)" = "$sha" ] || fail "$pkg does not match the manifest's SHA-256"
  mkdir -p "$tmp/$1"
  tar -xzf "$tmp/$pkg" -C "$tmp/$1"
  find "$tmp/$1" -mindepth 1 -maxdepth 1 -type d | head -n1
}

# The device: connectd, its stages and BUILD.
pkgdir=$(get "tar-$tar_arch")
[ -x "$pkgdir/connectd" ] && [ -d "$pkgdir/stages" ] && [ -f "$pkgdir/BUILD" ] || fail "tar-$tar_arch is not a device package"
# The device image's pieces, built with it: its entrypoint and healthcheck (remoteit-device container/) and the panel.
cdir=$(get "container-$tar_arch")
[ -x "$cdir/entrypoint" ] && [ -x "$cdir/healthcheck" ] && [ -x "$cdir/remoteit-panel" ] ||
  fail "container-$tar_arch does not hold the entrypoint, healthcheck and panel"

mkdir -p "$dest"
cp "$pkgdir/connectd" "$cdir/entrypoint" "$cdir/healthcheck" "$cdir/remoteit-panel" "$dest/"
cp -R "$pkgdir/stages" "$dest/stages"
# What the package is, as the device image's BUILD says it: connectd reports it. The format is the image's.
sed 's/^format .*/format container/' "$pkgdir/BUILD" > "$dest/BUILD"
grep -q '^format ' "$dest/BUILD" || echo 'format container' >> "$dest/BUILD"
echo solo > "$dest/default-stage"
echo "fetch: remote.it device $version ($(sed -n 's/^connectd //p' "$dest/BUILD")) for $arch"
