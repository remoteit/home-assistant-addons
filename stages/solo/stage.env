# The solo stage's add-on: a test build. bin/gen writes remoteit-solo/ from src/ with these values, this directory's
# release-keys (remoteit-device's release-keys-solo) and its CHANGELOG.md.
ADDON_DIR=remoteit-solo
ADDON_NAME="remote.it (solo test build)"
# Supervisor's identity for the add-on (its /data): letters, digits and _ only.
ADDON_SLUG=remoteit_solo
ADDON_VERSION=0.6.0
ADDON_DESCRIPTION="Test build for remote.it's solo stage, unsupported: reach Home Assistant and your home network from anywhere"
# Home Assistant's stage for the add-on: experimental shows it in the store only with Advanced mode on.
HA_STAGE=experimental
# Non-empty for a test build: the docs and the store say it is unsupported.
TEST=1
# remote.it's stage the device registers with, its portal, and where its device package is published.
STAGE=solo
PORTAL=https://app.solo.remote.it
DOWNLOADS=https://downloads.solo.remote.it/device
DEVICE_VERSION=1.1.0.20261010045250
