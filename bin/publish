#!/usr/bin/env bash
# Build an add-on's image for every architecture its config.yaml lists and push it, tagged with its version — the
# image Supervisor pulls (config.yaml `image`, without {arch}: one multi-architecture image).
#
#   bin/publish [add-on directory]        (remoteit)
#
# Needs docker buildx with a builder that can push several platforms (BUILDX_BUILDER, e.g. a docker-container one)
# and a login to the registry. The images are private until someone with the org's rights makes them public.
set -euo pipefail
dir=$(cd "$(dirname "$0")/.." && pwd)/${1:-remoteit}
cfg=$dir/config.yaml
version=$(sed -n 's/^version: *"\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$cfg")
image=$(sed -n 's/^image: *\(.*\)$/\1/p' "$cfg")
platforms=$(sed -n '/^arch:/,/^[a-z]/s/^  - //p' "$cfg" | sed 's/^aarch64$/linux\/arm64/; s/^amd64$/linux\/amd64/; s/^armv7$/linux\/arm\/v7/; s/^armhf$/linux\/arm\/v6/' | paste -sd, -)
[ -n "$version" ] && [ -n "$image" ] && [ -n "$platforms" ] || { echo "$cfg: no version, image or arch" >&2; exit 1; }
case $image in *'{arch}'*) echo "$cfg: image names {arch}; this builds one multi-architecture image" >&2; exit 1 ;; esac
echo "$image:$version for $platforms"
docker buildx build --platform "$platforms" --push -t "$image:$version" --build-arg BUILD_VERSION="$version" "$dir"
